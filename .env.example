NODE_ENV=development
GATEWAY_PORT=3000
CONNECTOR_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
MERCHANT_SERVICE_PORT=3003
MENU_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
ADMIN_API_PORT=3008
AUTH_SERVICE_PORT=3000
DATABASE_URL=postgresql://pdh:pdh@localhost:5432/pdh
REDIS_URL=redis://localhost:6379
MESSAGE_BROKER_TYPE=kafka
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Connector platform API configuration (replace CONNECTOR with DOORDASH, SWIGGY,
# GRUBHUB, UBER_EATS, or ZOMATO).
# DOORDASH_API_BASE_URL=https://api.doordash.example
# DOORDASH_API_TOKEN=
# DOORDASH_API_KEY=
# HMAC secret used to authenticate incoming webhooks. Define one for every
# enabled connector: DOORDASH, SWIGGY, GRUBHUB, UBER_EATS, and ZOMATO.
# DOORDASH_WEBHOOK_SECRET=
# SWIGGY_WEBHOOK_SECRET=
# GRUBHUB_WEBHOOK_SECRET=
# UBER_EATS_WEBHOOK_SECRET=
# ZOMATO_WEBHOOK_SECRET=

# Pinaka Restaurant POS order forwarding
POS_ORDERS_URL=https://merchantrestaurant.alektasolutions.com/wp-json/pinaka-restaurant-pos/v1/orders
POS_RESTAURANT_ID=1
POS_CAPTAIN_ID=1
POS_DEFAULT_PRODUCT_ID=1652
# Supply either POS_API_TOKEN or POS_AUTHORIZATION, never commit a real token.
POS_API_TOKEN=
# POS_AUTHORIZATION=Bearer your-jwt-here
